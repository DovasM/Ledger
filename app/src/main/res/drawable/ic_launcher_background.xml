<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background, from ledger_logo_14E_refined_final.svg.

  Paths stay in the source SVG's coordinate space; the <group> maps the source's 482pt tile onto the
  72dp the launcher actually shows, so the artwork keeps its designed proportions and the launcher's
  mask simply replaces the source's rounded rect. The source's inset border and top-edge rim light
  are deliberately dropped — both hug a tile edge that no longer exists once a mask is applied.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="0.149378"
        android:scaleY="0.149378"
        android:translateX="13.967"
        android:translateY="14.49">

        <path android:pathData="M-100,-100 H640 V640 H-100 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="80"
                    android:startY="480"
                    android:endX="470"
                    android:endY="55">
                    <item android:offset="0" android:color="#003F32" />
                    <item android:offset="0.58" android:color="#00513F" />
                    <item android:offset="1" android:color="#096A55" />
                </gradient>
            </aapt:attr>
        </path>

        <path android:pathData="M-100,-100 H640 V640 H-100 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="410"
                    android:centerY="90"
                    android:gradientRadius="360">
                    <item android:offset="0" android:color="#2182D7BA" />
                    <item android:offset="0.72" android:color="#0082D7BA" />
                    <item android:offset="1" android:color="#0082D7BA" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
