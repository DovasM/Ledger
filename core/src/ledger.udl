// UniFFI Interface Definition Language
// Defines the Kotlin ↔ Rust FFI boundary

namespace ledger {
    LedgerDb open_database(string db_path);
    // Splitting evenly has no exact answer in cents; the remainder is handed out deliberately
    // rather than rounded away. Exposed so the screen can show the shares before they are saved.
    sequence<i64> split_equally(i64 amount_cents, i32 people);
    i64 current_schema_version();
    [Throws=LlamaError]
    LlamaEngine llama_create(string model_path, u32 n_ctx);
};

[Error]
enum LlamaError {
    "LoadFailed",
    "GenerateFailed",
    "InvalidString",
};

[Error]
enum LedgerError {
    "DatabaseError",
    "NotFound",
    "InvalidInput",
};

dictionary Transaction {
    string id;
    string wallet_id;
    string title;
    string category;
    i64 amount_cents;
    boolean is_income;
    string? note;
    // The date the transaction happened. The row's own creation time stays in the database as
    // created_at but is not exposed — nothing needs it yet, and having both fields visible is what
    // let the two meanings blur in the first place.
    string occurred_at;
};

dictionary Wallet {
    string id;
    string name;
    string description;
    string currency;
    i64 balance_cents;
    // Off-budget accounts (a work account, an investment account) still count toward net worth but
    // are excluded from budgets, the daily allowance and the streak.
    boolean off_budget;
    string created_at;
};

// Neither income nor expense: folded into Transaction it would be counted twice by every report,
// once in each wallet.
dictionary Transfer {
    string id;
    string from_wallet_id;
    string to_wallet_id;
    i64 amount_cents;
    string? note;
    string created_at;
};

dictionary SavingsGoal {
    string id;
    string name;
    i64 current_amount_cents;
    i64 target_amount_cents;
    string? deadline;
    string created_at;
};

// A goal's balance and a debt's remaining amount are summed from these on every read rather than
// stored, so there is no second number that can disagree with the history.
dictionary GoalContribution {
    string id;
    string goal_id;
    i64 amount_cents;
    string? note;
    // "contribution", or "opening" for the row m7 wrote to carry the pre-history balance.
    string kind;
    string occurred_at;
};

dictionary DebtPayment {
    string id;
    string debt_id;
    i64 amount_cents;
    string? note;
    // "payment", "opening", or "adjustment" when the remaining amount was typed over by hand.
    string kind;
    string occurred_at;
};

// What a backup file contains, so the user can see what they are about to replace.
dictionary BackupInfo {
    string path;
    i64 schema_version;
    i64 wallets;
    i64 transactions;
    i64 categories;
    i64 budgets;
    i64 goals;
    i64 debts;
    i64 transfers;
    i64 recurring;
};

// A group of people splitting costs. Every figure is read from your side of the group.
dictionary ExpenseGroup {
    string id;
    string name;
    string emoji;
    string color_hex;
    i64 total_cents;
    i64 your_share_cents;
    // What you paid minus what you owe. Positive means the group owes you.
    i64 net_balance_cents;
    i32 member_count;
    i32 expense_count;
    string created_at;
};

dictionary GroupMember {
    string id;
    string group_id;
    string name;
    boolean is_you;
    i64 paid_cents;
    i64 owes_cents;
    i64 balance_cents;
};

dictionary SharedExpense {
    string id;
    string group_id;
    // Set when you paid and the money really left your wallet; null when somebody else did.
    string? transaction_id;
    string description;
    i64 amount_cents;
    string paid_by_member_id;
    string paid_by_name;
    i64 your_share_cents;
    string occurred_at;
};

dictionary ExpenseShare {
    string id;
    string shared_expense_id;
    string member_id;
    string member_name;
    i64 share_cents;
};

// One person's slice of an expense, as handed in when it is recorded.
dictionary ShareInput {
    string member_id;
    i64 share_cents;
};

dictionary MonthSummary {
    i64 total_income_cents;
    i64 total_expenses_cents;
    i64 net_savings_cents;
    i32 transaction_count;
};

dictionary Category {
    string id;
    string name;
    string icon_name;
    string color_hex;
    boolean is_expense;
    string created_at;
};

// category_id is optional so a budget can cap a whole wallet regardless of category; wallet_id is
// optional so a category budget can apply across every wallet. At least one must be set.
dictionary Budget {
    string id;
    string? category_id;
    string? wallet_id;
    i64 limit_amount_cents;
    string period;
    f64 alert_threshold;
    boolean carry_over;
    string created_at;
};

dictionary Debt {
    string id;
    string name;
    string debt_type;
    i64 total_amount_cents;
    i64 remaining_amount_cents;
    f64 apr;
    i64 monthly_payment_cents;
    string created_at;
};

dictionary RecurringTransaction {
    string id;
    string title;
    i64 amount_cents;
    string category;
    string wallet_id;
    boolean is_income;
    string frequency;
    string next_date;
    string created_at;
};

dictionary Tag {
    string id;
    string name;
    string created_at;
};

dictionary PriceAlert {
    string id;
    string symbol;
    string asset_name;
    i64 target_price_cents;
    string direction;
    boolean active;
    string created_at;
};

interface LlamaEngine {
    [Throws=LlamaError]
    string generate(string prompt, u32 n_predict, float temperature);
    i32 count_tokens(string prompt);
    string system_info();
    i64 last_prefill_ms();
    i64 last_decode_ms();
    void unload();
};

interface LedgerDb {
    // ── Transactions ──────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Transaction> list_transactions(string wallet_id, u32 limit, u32 offset);

    [Throws=LedgerError]
    sequence<Transaction> list_all_transactions(u32 limit, u32 offset);

    [Throws=LedgerError]
    Transaction create_transaction(string wallet_id, string title, string category, i64 amount_cents, boolean is_income, string? note, string? occurred_at);

    [Throws=LedgerError]
    Transaction update_transaction(string id, string title, string category, i64 amount_cents, boolean is_income, string? note, string? occurred_at);

    [Throws=LedgerError]
    void delete_transaction(string id);

    // ── Wallets ───────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Wallet> list_wallets();

    [Throws=LedgerError]
    Wallet create_wallet(string name, string description, string currency, i64 initial_balance_cents, boolean off_budget);

    [Throws=LedgerError]
    Wallet update_wallet(string id, string name, string description, string currency, boolean off_budget);

    [Throws=LedgerError]
    void delete_wallet(string id);

    // Deleting a wallet removes every transaction in it, so the UI needs to say how many first.
    [Throws=LedgerError]
    u32 count_transactions_for_wallet(string id);

    // ── Transfers ─────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Transfer> list_transfers(u32 limit, u32 offset);

    [Throws=LedgerError]
    Transfer create_transfer(string from_wallet_id, string to_wallet_id, i64 amount_cents, string? note, string? created_at);

    [Throws=LedgerError]
    void delete_transfer(string id);

    // ── Savings Goals ─────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<SavingsGoal> list_goals();

    [Throws=LedgerError]
    SavingsGoal create_goal(string name, i64 target_amount_cents, string? deadline);

    [Throws=LedgerError]
    sequence<GoalContribution> list_goal_contributions(string goal_id);

    [Throws=LedgerError]
    SavingsGoal add_contribution(string goal_id, i64 amount_cents, string? note, string? occurred_at);

    [Throws=LedgerError]
    SavingsGoal delete_contribution(string id);

    [Throws=LedgerError]
    SavingsGoal update_goal(string id, string name, i64 target_amount_cents, string? deadline);

    [Throws=LedgerError]
    void delete_goal(string id);

    // ── Statistics ────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    MonthSummary get_month_summary(i32 year, i32 month);

    // ── Categories ────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Category> list_categories();

    [Throws=LedgerError]
    Category create_category(string name, string icon_name, string color_hex, boolean is_expense);

    [Throws=LedgerError]
    Category update_category(string id, string name, string icon_name, string color_hex, boolean is_expense);

    [Throws=LedgerError]
    void delete_category(string id);

    // Deleting a category detaches its transactions and drops its budget — worth warning about.
    [Throws=LedgerError]
    u32 count_transactions_for_category(string id);

    // ── Budgets ───────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Budget> list_budgets();

    [Throws=LedgerError]
    Budget create_budget(string? category_id, string? wallet_id, i64 limit_amount_cents, string period, f64 alert_threshold, boolean carry_over);

    [Throws=LedgerError]
    Budget update_budget(string id, string? category_id, string? wallet_id, i64 limit_amount_cents, string period, f64 alert_threshold, boolean carry_over);

    [Throws=LedgerError]
    void delete_budget(string id);

    // ── Debts ─────────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Debt> list_debts();

    [Throws=LedgerError]
    Debt create_debt(string name, string debt_type, i64 total_amount_cents, i64 remaining_amount_cents, f64 apr, i64 monthly_payment_cents);

    [Throws=LedgerError]
    Debt update_debt(string id, string name, string debt_type, i64 total_amount_cents, i64 remaining_amount_cents, f64 apr, i64 monthly_payment_cents);

    [Throws=LedgerError]
    void delete_debt(string id);

    [Throws=LedgerError]
    sequence<DebtPayment> list_debt_payments(string debt_id);

    [Throws=LedgerError]
    Debt add_debt_payment(string debt_id, i64 amount_cents, string? note, string? occurred_at);

    [Throws=LedgerError]
    Debt delete_debt_payment(string id);

    // ── Recurring Transactions ────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<RecurringTransaction> list_recurring();

    [Throws=LedgerError]
    RecurringTransaction create_recurring(string title, i64 amount_cents, string category, string wallet_id, boolean is_income, string frequency, string next_date);

    [Throws=LedgerError]
    RecurringTransaction update_recurring(string id, string title, i64 amount_cents, string category, string frequency, string next_date);

    [Throws=LedgerError]
    void delete_recurring(string id);

    // ── Tags ──────────────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<Tag> list_tags();

    [Throws=LedgerError]
    Tag create_tag(string name);

    [Throws=LedgerError]
    void delete_tag(string id);

    [Throws=LedgerError]
    void add_tag_to_transaction(string transaction_id, string tag_id);

    [Throws=LedgerError]
    void remove_tag_from_transaction(string transaction_id, string tag_id);

    [Throws=LedgerError]
    sequence<Tag> list_transaction_tags(string transaction_id);

    // ── Shared expenses ───────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<ExpenseGroup> list_expense_groups();

    [Throws=LedgerError]
    ExpenseGroup create_expense_group(string name, string emoji, string color_hex, sequence<string> member_names);

    [Throws=LedgerError]
    ExpenseGroup update_expense_group(string id, string name, string emoji, string color_hex);

    [Throws=LedgerError]
    void delete_expense_group(string id);

    [Throws=LedgerError]
    sequence<GroupMember> list_group_members(string group_id);

    [Throws=LedgerError]
    GroupMember add_group_member(string group_id, string name);

    [Throws=LedgerError]
    void remove_group_member(string id);

    [Throws=LedgerError]
    sequence<SharedExpense> list_shared_expenses(string group_id);

    [Throws=LedgerError]
    SharedExpense add_shared_expense(string group_id, string description, i64 amount_cents,
                                     string paid_by_member_id, string? transaction_id,
                                     sequence<ShareInput> shares, string? occurred_at);

    [Throws=LedgerError]
    void delete_shared_expense(string id);

    [Throws=LedgerError]
    sequence<ExpenseShare> list_expense_shares(string shared_expense_id);

    // ── Backup & restore ──────────────────────────────────────────────────────
    [Throws=LedgerError]
    BackupInfo backup_database(string dest_path);

    [Throws=LedgerError]
    BackupInfo inspect_backup(string path);

    [Throws=LedgerError]
    BackupInfo restore_backup(string path);

    // ── Price Alerts ──────────────────────────────────────────────────────────
    [Throws=LedgerError]
    sequence<PriceAlert> list_price_alerts();

    [Throws=LedgerError]
    PriceAlert create_price_alert(string symbol, string asset_name, i64 target_price_cents, string direction);

    [Throws=LedgerError]
    PriceAlert set_price_alert_active(string id, boolean active);

    [Throws=LedgerError]
    void delete_price_alert(string id);
};
